# Copy to .env (or set these in your host's dashboard). All optional.

# Where to listen. In production (NODE_ENV=production) HOST defaults to 0.0.0.0.
PORT=5317
HOST=127.0.0.1
NODE_ENV=development

# SQLite file. Put it on a persistent disk/volume in production.
DB_FILE=data/grimoire.db

# Behind a reverse proxy / PaaS load balancer (Render, Railway, Fly, nginx…):
# trusts X-Forwarded-For (rate limits) and X-Forwarded-Proto (Secure cookies + HSTS).
TRUST_PROXY=0
# Force Secure cookies even without a proxy header (serving HTTPS directly).
SECURE_COOKIES=0

# Abuse limits (per minute).
AUTH_RATE_LIMIT=10
WRITE_RATE_LIMIT=300
